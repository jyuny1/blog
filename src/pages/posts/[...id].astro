---
import { getCollection, render, type CollectionEntry } from "astro:content"
import TableOfContents from "../../components/TableOfContents.astro"
import { formatDate, isPublished, readingTime } from "../../consts"
import BaseLayout from "../../layouts/BaseLayout.astro"

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => isPublished(data))
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }))
}

interface Props {
  post: CollectionEntry<"blog">
}

const { post } = Astro.props
const { Content, headings } = await render(post)
const description = post.data.description ?? post.data.title
---

<BaseLayout
  title={post.data.title}
  description={description}
  image={post.data.image}
  type="article"
>
  <article class="article-shell">
    <header class="article-header">
      <p class="eyebrow">Essay</p>
      <h1>{post.data.title}</h1>
      {post.data.description && <p class="article-deck">{post.data.description}</p>}
      <div class="article-meta">
        <time datetime={post.data.date?.toISOString()}>{formatDate(post.data.date)}</time>
        <span>{readingTime(post.body)} min read</span>
        {post.data.author && <span>{post.data.author}</span>}
      </div>
      {
        post.data.tags.length > 0 && (
          <ul class="tag-list" aria-label="文章標籤">
            {post.data.tags.map((tag) => (
              <li><a href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a></li>
            ))}
          </ul>
        )
      }
    </header>

    <TableOfContents {headings} />
    <div class="prose">
      <Content />
    </div>

    <footer class="article-footer">
      <a href="/">← Back to all notes</a>
    </footer>
  </article>
</BaseLayout>
