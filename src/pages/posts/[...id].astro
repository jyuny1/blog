---
import { getCollection, render, type CollectionEntry } from "astro:content"
import TableOfContents from "../../components/TableOfContents.astro"
import { formatDate, isPublished, readingTime } from "../../consts"
import BaseLayout from "../../layouts/BaseLayout.astro"

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => isPublished(data))
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }))
}

interface Props {
  post: CollectionEntry<"blog">
}

const { post } = Astro.props
const { Content, headings } = await render(post)
const description = post.data.description ?? post.data.title

const headingBase =
  headings.length > 0
    ? Math.max(1, Math.min(5, Math.min(...headings.map((h) => h.depth))))
    : 0

function getFirstMarkdownImage(body?: string): { url: string; alt: string } | undefined {
  if (!body) return undefined
  const regex = /!\[(.*?)\]\(\s*(\S+?)(?:\s+["'][^"']*["'])?\s*\)/g
  let match: RegExpExecArray | null
  while ((match = regex.exec(body)) !== null) {
    const [, rawAlt, rawUrl] = match
    const url = rawUrl.replace(/^<|>$/g, "")
    if (url.startsWith("https://") && !url.toLowerCase().endsWith(".svg")) {
      return { url, alt: rawAlt.trim() }
    }
  }
  return undefined
}

function isUsefulAlt(alt?: string): alt is string {
  if (!alt || alt.trim() === "") return false
  if (/^Pasted image\b/i.test(alt)) return false
  if (/^image\b/i.test(alt)) return false
  if (/\.(png|jpe?g|webp|gif)$/i.test(alt)) return false
  return true
}

const firstImage = !post.data.image ? getFirstMarkdownImage(post.body) : undefined
const image = post.data.image ?? firstImage?.url
const imageAlt =
  firstImage && isUsefulAlt(firstImage.alt) ? firstImage.alt : post.data.title
---

<BaseLayout
  title={post.data.title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  publishedTime={post.data.date?.toISOString()}
  modifiedTime={post.data.updated?.toISOString()}
  type="article"
>
  <article class="article-shell">
    <header class="article-header">
      <p class="eyebrow">Essay</p>
      <h1>{post.data.title}</h1>
      {post.data.description && <p class="article-deck">{post.data.description}</p>}
      <div class="article-meta">
        <time datetime={post.data.date?.toISOString()}>{formatDate(post.data.date)}</time>
        <span>{readingTime(post.body)} min read</span>
        {post.data.author && <span>{post.data.author}</span>}
      </div>
      {
        post.data.tags.length > 0 && (
          <ul class="tag-list" aria-label="文章標籤">
            {post.data.tags.map((tag) => (
              <li><a href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a></li>
            ))}
          </ul>
        )
      }
    </header>

    <TableOfContents {headings} />
    <div class="prose" data-heading-base={headingBase || undefined}>
      <Content />
    </div>

    <footer class="article-footer">
      <a href="/">← Back to all notes</a>
    </footer>
  </article>
</BaseLayout>
